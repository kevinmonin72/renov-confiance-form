# HubSpot CRM API Configuration
# Créez une Private App dans HubSpot (Settings > Integrations > Private Apps)
# Scopes requis :
# - crm.objects.contacts.read
# - crm.objects.contacts.write
# - crm.objects.deals.read
# - crm.objects.deals.write

HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optionnel : ID du Pipeline Deals dans HubSpot (par défaut : "default")
HUBSPOT_PIPELINE_ID=default

# Optionnel : ID du commercial propriétaire par défaut (HubSpot Owner ID)
# HUBSPOT_DEFAULT_OWNER_ID=123456789
